# ==========================================================
# HIFA SAAS - VARIABLES DE ENTORNO
# ==========================================================

# Puerto de ejecución (solo relevante en modo local / Docker)
PORT=3000

# Directorio de datos (por defecto ./data en local, o /tmp/hifa-data en Vercel)
DATA_DIR=./data

# Modos de base de datos y almacenamiento (local | spiderweb)
DB_MODE=local
STORAGE_MODE=local

# ==========================================================
# CONFIGURACIÓN DE NUBE / VERCEL (SPIDERWEBAPI)
# Necesario para persistencia en Vercel Serverless
# ==========================================================
spiderwebdbname="sw_Franco Calegari_hifaRemote"
spiderapikey=a6ccadadd08b030c1acbe89bbe66c202b6c9658736165072ab3fa5719b3749cf
spidercloudstrogaeid=47
SPIDERWEB_API_URL=https://spiderwebargapi.com.ar/api/v1

# ==========================================================
# CREDENCIALES DEL ADMINISTRADOR DEL SAAS
# Permiten ingresar al panel /admin en producción
# ==========================================================
ADMIN_EMAIL=admin@hifa.saas
ADMIN_PASSWORD=admin123
